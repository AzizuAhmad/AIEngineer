        <calculation class='tableau' formula='IF [T Category Set] THEN [t_category]&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Metric %' datatype='real' name='[Calculation_1762877791534043159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1762877791351877639] / TOTAL([Calculation_1762877791351877639]) * 100'>
          <table-calc ordering-type='Rows' />

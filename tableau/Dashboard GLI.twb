      <column caption='BTN AVG Basket size' datatype='integer' name='[BTN AVG Basket Val (copy)_1762877791370629134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(4)' />
      </column>
      <column caption='BTN Member' datatype='integer' name='[BTN AVG Basket size (copy)_1762877791370694671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(5)' />
      </column>
      <column caption='BTN Revenue' datatype='integer' name='[BTN Transaksi (copy)_1762877791367786508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1762877791351877639] / TOTAL([Calculation_1762877791351877639])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1762877791583694873] / TOTAL([Calculation_1762877791583694873])'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_1762877791297265666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([t_net])' />
      </column>
      <column caption='Uniq Member' datatype='integer' name='[Calculation_1762877791298084867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([t_members])' />
      </column>
      <column caption='Month Year' datatype='datetime' name='[Calculation_1762877791298228228]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[t_date])' />
      </column>
      <column caption='Avg Basket Value' datatype='real' name='[Calculation_1762877791298723845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([t_net])/COUNTD([t_struk_id])' />
      </column>
      <column caption='Avg Basket Size' datatype='real' name='[Calculation_1762877791298895878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([t_qty])/COUNTD([t_struk_id])' />
      </column>
      <column caption='Dynamic Metric' datatype='real' name='[Calculation_1762877791351877639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN SUM([t_net])&#13;&#10;WHEN 2 THEN COUNTD([t_struk_id])&#13;&#10;WHEN 3 THEN SUM([t_net]) / COUNTD([t_struk_id])&#13;&#10;WHEN 4 THEN SUM([t_qty]) / COUNTD([t_struk_id])&#13;&#10;WHEN 5 THEN COUNTD([t_members])&#13;&#10;END' />
      </column>
      <column caption='Is Selected' datatype='string' name='[Calculation_1762877791352664072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN &quot;Revenue&quot;&#13;&#10;WHEN 2 THEN &quot;Transaksi&quot;&#13;&#10;WHEN 3 THEN &quot;Avg Basket Value&quot;&#13;&#10;WHEN 4 THEN &quot;Avg Basket Size&quot;&#13;&#10;WHEN 5 THEN &quot;Member&quot;&#13;&#10;END' />
      </column>
      <column caption='Metric value' datatype='integer' name='[Calculation_1762877791355715593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_1762877791352664072]&#13;&#10;WHEN &quot;Revenue&quot; THEN 1&#13;&#10;WHEN &quot;Transaksi&quot; THEN 2&#13;&#10;WHEN &quot;Avg Basket Value&quot; THEN 3&#13;&#10;WHEN &quot;Avg Basket Size&quot; THEN 4&#13;&#10;WHEN &quot;Member&quot; THEN 5&#13;&#10;END' />
      </column>
      <column caption='BTN Transaksi' datatype='integer' name='[Calculation_1762877791360667658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(2)' />
      </column>
      <column caption='Dynamic Label' datatype='string' name='[Calculation_1762877791366701067]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN &quot;Rp &quot; + STR(ROUND(SUM([t_net])/1000000, 2)) + &quot; M&quot;&#13;&#10;WHEN 2 THEN &#13;&#10;  IF COUNTD([t_struk_id]) &gt;= 1000 &#13;&#10;  THEN STR(INT(COUNTD([t_struk_id])/1000)) + &quot;.&quot; + RIGHT(&quot;000&quot; + STR(INT(COUNTD([t_struk_id]) % 1000)), 3)&#13;&#10;  ELSE STR(COUNTD([t_struk_id]))&#13;&#10;  END&#13;&#10;WHEN 3 THEN &quot;Rp &quot; + &#13;&#10;  IF SUM([t_net])/COUNTD([t_struk_id]) &gt;= 1000&#13;&#10;  THEN STR(INT(SUM([t_net])/COUNTD([t_struk_id])/1000)) + &quot;.&quot; + RIGHT(&quot;000&quot; + STR(INT(SUM([t_net])/COUNTD([t_struk_id]) % 1000)), 3)&#13;&#10;  ELSE STR(ROUND(SUM([t_net])/COUNTD([t_struk_id]), 0))&#13;&#10;  END&#13;&#10;WHEN 4 THEN STR(ROUND(SUM([t_qty])/COUNTD([t_struk_id]), 1))&#13;&#10;WHEN 5 THEN &#13;&#10;  IF COUNTD([t_members]) &gt;= 1000&#13;&#10;  THEN STR(INT(COUNTD([t_members])/1000)) + &quot;.&quot; + RIGHT(&quot;000&quot; + STR(INT(COUNTD([t_members]) % 1000)), 3)&#13;&#10;  ELSE STR(COUNTD([t_members]))&#13;&#10;  END&#13;&#10;END' />
      </column>
      <column caption='BTN AVG Basket Val' datatype='integer' name='[Calculation_1762877791370469389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(3)' />
      </column>
      <column caption='Dynamic Title Trend' datatype='string' name='[Calculation_1762877791374639121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN &quot;Monthly Revenue Trend&quot;&#13;&#10;WHEN 2 THEN &quot;Monthly Transaksi Trend&quot;&#13;&#10;WHEN 3 THEN &quot;Monthly Avg Basket Value Trend&quot;&#13;&#10;WHEN 4 THEN &quot;Monthly Avg Basket Size Trend&quot;&#13;&#10;WHEN 5 THEN &quot;Monthly Unique Member Trend&quot;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Title Category ' datatype='string' name='[Calculation_1762877791507738642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN &quot;Revenue by Category&quot;&#13;&#10;WHEN 2 THEN &quot;Transaksi by Category&quot;&#13;&#10;WHEN 3 THEN &quot;Avg Basket Value by Category&quot;&#13;&#10;WHEN 4 THEN &quot;Avg Basket Size by Category&quot;&#13;&#10;WHEN 5 THEN &quot;Unique Member by Category&quot;&#13;&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_1762877791516516373]' role='dimension' type='nominal'>

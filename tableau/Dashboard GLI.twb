          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01iuxam1hk6mnd0zo167g05xn4re'>
            <column caption='Month Year' datatype='datetime' name='[Calculation_1762877791298228228]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[t_date])' />
            </column>
            <column caption='Dynamic Metric' datatype='real' name='[Calculation_1762877791351877639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN SUM([t_net])&#13;&#10;WHEN 2 THEN COUNTD([t_struk_id])&#13;&#10;WHEN 3 THEN SUM([t_net]) / COUNTD([t_struk_id])&#13;&#10;WHEN 4 THEN SUM([t_qty]) / COUNTD([t_struk_id])&#13;&#10;WHEN 5 THEN COUNTD([t_members])&#13;&#10;END' />
            </column>
            <column caption='Dynamic Label' datatype='string' name='[Calculation_1762877791366701067]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN &quot;Rp &quot; + STR(ROUND(SUM([t_net])/1000000, 2)) + &quot; M&quot;&#13;&#10;WHEN 2 THEN &#13;&#10;  IF COUNTD([t_struk_id]) &gt;= 1000 &#13;&#10;  THEN STR(INT(COUNTD([t_struk_id])/1000)) + &quot;.&quot; + RIGHT(&quot;000&quot; + STR(INT(COUNTD([t_struk_id]) % 1000)), 3)&#13;&#10;  ELSE STR(COUNTD([t_struk_id]))&#13;&#10;  END&#13;&#10;WHEN 3 THEN &quot;Rp &quot; + &#13;&#10;  IF SUM([t_net])/COUNTD([t_struk_id]) &gt;= 1000&#13;&#10;  THEN STR(INT(SUM([t_net])/COUNTD([t_struk_id])/1000)) + &quot;.&quot; + RIGHT(&quot;000&quot; + STR(INT(SUM([t_net])/COUNTD([t_struk_id]) % 1000)), 3)&#13;&#10;  ELSE STR(ROUND(SUM([t_net])/COUNTD([t_struk_id]), 0))&#13;&#10;  END&#13;&#10;WHEN 4 THEN STR(ROUND(SUM([t_qty])/COUNTD([t_struk_id]), 1))&#13;&#10;WHEN 5 THEN &#13;&#10;  IF COUNTD([t_members]) &gt;= 1000&#13;&#10;  THEN STR(INT(COUNTD([t_members])/1000)) + &quot;.&quot; + RIGHT(&quot;000&quot; + STR(INT(COUNTD([t_members]) % 1000)), 3)&#13;&#10;  ELSE STR(COUNTD([t_members]))&#13;&#10;  END&#13;&#10;END' />
            </column>
            <column caption='Nama Store' datatype='string' name='[NAMA_STORE]' role='dimension' type='nominal' />
            <column caption='Category Group' datatype='string' name='[category_group]' role='dimension' type='nominal' />
            <column-instance column='[NAMA_STORE]' derivation='None' name='[none:NAMA_STORE:nk]' pivot='key' type='nominal' />

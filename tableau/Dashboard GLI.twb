  <worksheets>
    <worksheet name='AVG Basket Size'>
      <table>
        <view>
          <datasources>
            <datasource caption='data_main' name='federated.01iuxam1hk6mnd0zo167g05xn4re' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Revenue' caption='Select Metric' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Revenue' />
                <alias key='2' value='Transaksi' />
                <alias key='3' value='Avg Basket Value' />
                <alias key='4' value='Avg Basket Size' />
                <alias key='5' value='Unique Member' />
              </aliases>
            </column>
            <column caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2020-01-01#'>
              <calculation class='tableau' formula='#2020-01-01#' />
              <range max='#2021-03-31#' min='#2020-01-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='#2021-03-31#'>
              <calculation class='tableau' formula='#2021-03-31#' />
              <range max='#2021-03-31#' min='#2020-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01iuxam1hk6mnd0zo167g05xn4re'>
            <column caption='BTN AVG Basket size' datatype='integer' name='[BTN AVG Basket Val (copy)_1762877791370629134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(4)' />
            </column>
            <column caption='Avg Basket Size' datatype='real' name='[Calculation_1762877791298895878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([t_qty])/COUNTD([t_struk_id])' />
            </column>
            <column caption='Dynamic Title Trend' datatype='string' name='[Calculation_1762877791374639121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN 1 THEN &quot;Monthly Revenue Trend&quot;&#13;&#10;WHEN 2 THEN &quot;Monthly Transaksi Trend&quot;&#13;&#10;WHEN 3 THEN &quot;Monthly Avg Basket Value Trend&quot;&#13;&#10;WHEN 4 THEN &quot;Monthly Avg Basket Size Trend&quot;&#13;&#10;WHEN 5 THEN &quot;Monthly Unique Member Trend&quot;&#13;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1762877791516516373]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[t_date] &gt;= [Parameters].[Parameter 2] and [t_date] &lt;= [Parameters].[Parameter 3]' />
            </column>
            <column caption='Nama Branch' datatype='string' name='[NAMA_BRANCH]' role='dimension' type='nominal' />
            <column caption='Nama Store' datatype='string' name='[NAMA_STORE]' role='dimension' type='nominal' />
            <column caption='Regional' datatype='string' name='[REGIONAL]' role='dimension' type='nominal' />
            <column caption='Category Group' datatype='string' name='[category_group]' role='dimension' type='nominal' />
            <column caption='Is Weekend' datatype='boolean' name='[is_weekend]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1762877791516516373]' derivation='None' name='[none:Calculation_1762877791516516373:nk]' pivot='key' type='nominal' />
            <column caption='T Date' datatype='date' name='[t_date]' role='dimension' type='ordinal' />
            <column caption='T Qty' datatype='integer' name='[t_qty]' role='measure' type='quantitative' />
            <column caption='T Struk Id' datatype='string' name='[t_struk_id]' role='dimension' type='nominal' />
            <column-instance column='[BTN AVG Basket Val (copy)_1762877791370629134]' derivation='User' name='[usr:BTN AVG Basket Val (copy)_1762877791370629134:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1762877791298895878]' derivation='User' name='[usr:Calculation_1762877791298895878:qk]' pivot='key' type='quantitative' />
            <column-instance column='[t_date]' derivation='Weekday' name='[wd:t_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.01iuxam1hk6mnd0zo167g05xn4re].[Action (Category Group)]' context='true'>
            <groupfilter function='level-members' level='[category_group]' user:ui-action-filter='[Action10_069AF80EA784433BAB7FBBD64007BB75]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.01iuxam1hk6mnd0zo167g05xn4re].[Action (Dynamic Title Trend)]'>
            <groupfilter function='level-members' level='[Calculation_1762877791374639121]' user:ui-action-filter='[Action9_50CA53B239F84C6BA58D01CF35BC314A]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.01iuxam1hk6mnd0zo167g05xn4re].[Action (Is Weekend,WEEKDAY(T Date))]' context='true'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action7_82839071CFE848BABD5CDA03D368A87D]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[is_weekend]' />
              <groupfilter function='level-members' level='[wd:t_date:ok]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.01iuxam1hk6mnd0zo167g05xn4re].[Action (Nama Branch,Nama Store)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action9_50CA53B239F84C6BA58D01CF35BC314A]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[NAMA_BRANCH]' />
              <groupfilter function='level-members' level='[NAMA_STORE]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.01iuxam1hk6mnd0zo167g05xn4re].[Action (Regional)]' context='true'>
            <groupfilter function='level-members' level='[REGIONAL]' user:ui-action-filter='[Action8_6EE6FFFA83384870BDB4159439604280]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.01iuxam1hk6mnd0zo167g05xn4re].[none:Calculation_1762877791516516373:nk]' context='true'>
            <groupfilter function='member' level='[none:Calculation_1762877791516516373:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
